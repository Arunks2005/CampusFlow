# Copy this file to .env.sensor and replace the placeholders.
# .env.sensor is ignored by Git. Never commit real sensor tokens.
CAMPUSFLOW_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
CAMPUSFLOW_SUPABASE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
CAMPUSFLOW_NODE_TOKEN_C1=YOUR_FIRST_SENSOR_TOKEN
CAMPUSFLOW_NODE_TOKEN_C2=YOUR_SECOND_SENSOR_TOKEN
CAMPUSFLOW_CAMERA_INDEX=0
CAMPUSFLOW_CAMERA_ZONES=cafeteria_c1,cafeteria_c2
CAMPUSFLOW_HEADLESS=1

